{
  "name": "AI4Law Simulator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
  "postCreateCommand": "python -m pip install -r requirements.txt && cd frontend && npm install",
  "postStartCommand": "bash .devcontainer/start-preview.sh",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "AI4Law Simulator", "onAutoForward": "openPreview" },
    "8000": { "label": "AI4Law API", "onAutoForward": "silent" }
  }
}
